# Postgres password (used by both the postgres and app services). Any
# characters are fine — the app builds its DB connection string with
# net/url, which percent-encodes the password correctly.
CAKENIFY_DB_PASSWORD=change-me

# First-boot admin account. Only used to seed the very first user when the
# users table is empty — leave blank on subsequent runs, it's a no-op once
# any user exists.
CAKENIFY_ADMIN_USERNAME=
CAKENIFY_ADMIN_PASSWORD=

# ntfy server that notifications are published to. Each user configures
# their own topic/token via the notification settings page in the UI.
CAKENIFY_NTFY_BASE_URL=https://ntfy.bikasolutions.co.za

# IANA timezone the 10:00 daily reminder / Sunday digest are evaluated in.
CAKENIFY_TIMEZONE=Africa/Johannesburg

# How long a login session stays valid.
CAKENIFY_SESSION_TTL=720h

# Set to "false" only for local http (non-TLS) testing without cloudflared.
CAKENIFY_SECURE_COOKIES=true

# Cloudflare Tunnel token for the cloudflared service (tunnel + hostname
# already configured on the Cloudflare side).
CLOUDFLARE_TUNNEL_TOKEN=
